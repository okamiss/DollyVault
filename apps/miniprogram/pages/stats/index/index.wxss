.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.stat-card {
  padding: 24rpx;
}

.stat-value {
  display: block;
  margin-top: 12rpx;
  color: #18243a;
  font-size: 34rpx;
  font-weight: 900;
}

.chart-card {
  margin-top: 20rpx;
  padding: 26rpx;
}

.chart-title {
  display: block;
  margin-bottom: 22rpx;
  color: #18243a;
  font-size: 30rpx;
  font-weight: 800;
}

.bar-row {
  display: grid;
  grid-template-columns: 128rpx 1fr 48rpx;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.bar-label {
  color: #18243a;
  font-size: 24rpx;
}

.bar-track {
  height: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f1f3f7;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff5c9a, #7c5cff);
}

.bar-value {
  color: #7a8494;
  font-size: 24rpx;
  text-align: right;
}

.trend-canvas {
  width: 100%;
  height: 360rpx;
}
