<view class="page">
  <view class="page-header">
    <view>
      <text class="page-title">收藏统计</text>
      <text class="page-subtitle">统计基于你录入的价格与入手信息，仅用于个人整理。</text>
    </view>
  </view>

  <empty-state
    wx:if="{{!stats || stats.totalCount === 0}}"
    title="暂无持有中的藏品"
    description="添加库存后即可查看收藏汇总。"
  />

  <view wx:else>
    <view class="stats-grid">
      <view wx:for="{{statCards}}" wx:key="label" class="stat-card card">
        <text class="muted">{{item.label}}</text>
        <text class="stat-value">{{item.value}}</text>
      </view>
    </view>

    <view class="card chart-card">
      <text class="chart-title">按角色分布</text>
      <view wx:for="{{characterBars}}" wx:key="name" class="bar-row">
        <text class="bar-label">{{item.name}}</text>
        <view class="bar-track">
          <view class="bar-fill" style="width: {{item.width}}%;"></view>
        </view>
        <text class="bar-value">{{item.value}}</text>
      </view>
    </view>

    <view class="card chart-card">
      <text class="chart-title">估值趋势</text>
      <canvas type="2d" id="trendCanvas" class="trend-canvas"></canvas>
    </view>
  </view>
</view>
