<view class="page">
  <view class="page-header">
    <view>
      <text class="page-title">图鉴</text>
      <text class="page-subtitle">公共商品数据库，可从图鉴加入你的个人收藏。</text>
    </view>
    <button class="mini-primary" bindtap="goCreate">创建图鉴</button>
  </view>

  <view class="search-row">
    <input class="search-input" confirm-type="search" value="{{search}}" placeholder="搜索名称、角色、系列或标签" bindinput="onSearchInput" bindconfirm="submitSearch" />
    <button class="search-button" bindtap="submitSearch">搜索</button>
  </view>

  <empty-state
    wx:if="{{owned.length === 0 && publicItems.length === 0 && !loading}}"
    title="暂无图鉴数据"
    description="创建你的第一条图鉴，后续就可以加入收藏。"
    action-text="创建第一个图鉴"
    bind:action="goCreate"
  />

  <view wx:if="{{owned.length > 0}}" class="catalog-section">
    <view class="section-title-row">
      <text class="section-title">我的图鉴</text>
      <text class="muted">{{owned.length}} 条</text>
    </view>
    <view class="catalog-grid">
      <view wx:for="{{owned}}" wx:key="id" class="catalog-card card" data-id="{{item.id}}" bindtap="goDetail">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
        <view wx:else class="catalog-thumb image-placeholder"></view>
        <view class="catalog-body">
          <text class="catalog-name">{{item.name}}</text>
          <text class="muted">{{item.characterName}} · {{item.series || '未设置系列'}}</text>
          <view class="tag-row">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
          </view>
          <text class="muted">使用 {{item.usageCount || 0}} 次</text>
          <text class="muted">{{item.officialPriceText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{publicItems.length > 0}}" class="catalog-section">
    <view class="section-title-row">
      <text class="section-title">公共图鉴</text>
      <text class="muted">{{publicItems.length}} 条</text>
    </view>
    <view class="catalog-grid">
      <view wx:for="{{publicItems}}" wx:key="id" class="catalog-card card" data-id="{{item.id}}" bindtap="goDetail">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
        <view wx:else class="catalog-thumb image-placeholder"></view>
        <view class="catalog-body">
          <text class="catalog-name">{{item.name}}</text>
          <text class="muted">{{item.characterName}} · {{item.series || '未设置系列'}}</text>
          <view class="tag-row">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
          </view>
          <text class="muted">使用 {{item.usageCount || 0}} 次</text>
          <text class="muted">{{item.officialPriceText}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
