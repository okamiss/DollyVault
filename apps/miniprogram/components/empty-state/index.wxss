.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
  border: 1rpx solid #e8edf4;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: #fff0f6;
  color: #ff5c9a;
  font-weight: 800;
}

.empty-title {
  color: #18243a;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-description {
  margin-top: 10rpx;
  color: #7a8494;
  font-size: 26rpx;
  line-height: 1.5;
}

.empty-action {
  margin-top: 28rpx;
  padding: 0 32rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #ff5c9a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}
