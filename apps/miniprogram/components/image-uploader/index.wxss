.uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-item,
.upload-add {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #fff0f6;
}

.upload-item image {
  width: 100%;
  height: 100%;
}

.remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  min-height: 0;
  padding: 0;
  border-radius: 50%;
  background: rgba(24, 36, 58, 0.72);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
}

.upload-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #ff9fc0;
  color: #ff5c9a;
  font-size: 24rpx;
}

.plus {
  font-size: 48rpx;
  line-height: 1;
}
